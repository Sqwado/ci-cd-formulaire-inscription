# .env.sample — Variables à configurer pour le déploiement Zero Touch
#
# Copie locale (dev) : cp .env.sample .env
# CI/CD : GitHub > Settings > Secrets and variables > Actions
# NE PAS committer de vraies valeurs. NE PAS donner vos clés AWS au correcteur.

# =============================================================================
# GitHub Secrets obligatoires (workflow Deploy)
# =============================================================================

# --- AWS ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3

# --- Registry Docker privé (HTTPS, port 443) ---
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# --- Base de données & application (EC2 applicative) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=ynov_ci
MYSQL_USER=root
MYSQL_PASSWORD=

# --- Compte administrateur API (seed au 1er démarrage backend) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=

# =============================================================================
# Variables injectées automatiquement par la pipeline (ne pas mettre en secret)
# =============================================================================
# - IP EC2 registry / app : outputs Terraform
# - REACT_APP_API_URL     : build frontend (IP app:8000)
# - inventory.ini         : généré via terraform output -raw ansible_inventory
# - Clé SSH volatile      : générée par Terraform, chmod 400 sur le runner

# =============================================================================
# Développement local uniquement (docker compose à la racine)
# =============================================================================
MYSQL_HOST=db
MYSQL_PORT=3306
REACT_APP_API_URL=http://localhost:8000
REACT_APP_OFFLINE_MODE=false

# =============================================================================
# Lancement du déploiement
# =============================================================================
# GitHub Actions > workflow "Deploy" > Run workflow
# scope "full"        : infra complète (registry + app + images)
# scope "application" : images + app uniquement (registry déjà en place)
