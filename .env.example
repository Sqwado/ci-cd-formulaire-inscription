# Copier ce fichier en .env à la racine du projet :
# cp .env.example .env

# --- MySQL (docker compose : services db et server) ---
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=ynov_ci
MYSQL_USER=root
MYSQL_HOST=db
MYSQL_PORT=3306
# Mot de passe applicatif (Alwaysdata en prod ; vide en local = MYSQL_ROOT_PASSWORD)
MYSQL_PASSWORD=

# --- Admin (seed au demarrage de l API si la table est vide) ---
ADMIN_EMAIL=loise.fenoll@ynov.com
ADMIN_PASSWORD=PvdrTAzTeR247sDnAZBr
JWT_SECRET=change_me_in_production

# --- React API ---
REACT_APP_API_URL=http://localhost:8000
# true = file d attente en memoire (sans appel API direct)
REACT_APP_OFFLINE_MODE=false

