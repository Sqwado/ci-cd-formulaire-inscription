# Copier ce fichier en .env à la racine pour le développement local :
# cp .env.example .env
#
# Pour le déploiement CI/CD (workflow Deploy), configurer les mêmes variables
# dans GitHub > Settings > Secrets and variables > Actions.
# NE PAS committer de vraies valeurs dans le dépôt.

# =============================================================================
# Développement local (docker compose)
# =============================================================================

# --- MySQL (services db et server) ---
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=ynov_ci
MYSQL_USER=root
MYSQL_HOST=db
MYSQL_PORT=3306
# Vide en local = MYSQL_ROOT_PASSWORD
MYSQL_PASSWORD=

# --- Admin (seed au démarrage de l'API si la table est vide) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
JWT_SECRET=change_me_in_production

# --- React ---
REACT_APP_API_URL=http://localhost:8000
# true = file d'attente en mémoire (sans appel API direct)
REACT_APP_OFFLINE_MODE=false

# =============================================================================
# Déploiement AWS (GitHub Secrets — infra/registry + infra/app)
# =============================================================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-3

# =============================================================================
# Registry Docker privé (GitHub Secrets — HTTPS)
# =============================================================================
# Identifiants pour docker login sur <REGISTRY_IP>:443
# REGISTRY_USERNAME=admin
# REGISTRY_PASSWORD=

# =============================================================================
# Notes déploiement
# =============================================================================
# - Aucune clé AWS ne doit être commitée dans le dépôt.
# - REGISTRY_USERNAME / REGISTRY_PASSWORD : Ansible (registry + app) et pipeline
#   (docker login / push).
# - REACT_APP_API_URL est injecté automatiquement au build frontend avec l'IP
#   publique de l'EC2 applicative (output Terraform).
# - Déclencher le déploiement : GitHub Actions > workflow "Deploy" > Run workflow

# =============================================================================
# Alwaysdata (production — secrets GitHub / Vercel, PAS dans .env local)
# =============================================================================
# Ne pas dupliquer MYSQL_* ici : ça écraserait la config Docker locale.
# MYSQL_HOST=mysql-votrecompte.alwaysdata.net
# MYSQL_PORT=3306
# MYSQL_DATABASE=votrecompte_inscription
# MYSQL_USER=votrecompte
# MYSQL_PASSWORD=

# =============================================================================
# Vercel (secrets GitHub Actions + variables Vercel dashboard)
# =============================================================================
# VERCEL_TOKEN      -> compte Vercel > Settings > Tokens
# VERCEL_ORG_ID     -> dashboard Vercel > Settings > Team ID
# VERCEL_PROJECT_ID -> projet Vercel > Settings > Project ID
# Variables MySQL/admin à configurer aussi dans Vercel > Project > Environment Variables
